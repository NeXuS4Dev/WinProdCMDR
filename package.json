{
  "name": "winprodcmdr",
  "productName": "WinProdCMDR",
  "description": "Windows Production Commander \u2014 manage Windows with a classic Office 2016 ribbon suite",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "author": "Shay",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "web": "vite",
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fluentui/react": "^8.125.7",
    "@fluentui/react-icons-mdl2": "^1.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
